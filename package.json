{
	"name": "elitedev",
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": ">=24.15.0"
	},
	"packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
	"scripts": {
		"dev": "concurrently \"pnpm:dev:content\" \"pnpm:dev:svelte\"",
		"dev:fw": "pnpm -C packages/farming-weight build:watch",
		"dev:all": "concurrently \"pnpm:dev:content\" \"pnpm:dev:svelte\" \"pnpm:dev:fw\"",
		"dev:content": "velite dev --watch",
		"dev:svelte": "pnpm vite dev",
		"devhost": "vite dev --host",
		"build": "velite && pnpm -C packages/farming-weight build && vite build",
		"build:content": "velite",
		"build:svelte": "vite build",
		"build:fw": "pnpm -C packages/farming-weight build",
		"package": "svelte-kit package",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"deploy": "node build/index.js",
		"check": "pnpm -C packages/farming-weight build && pnpm build:content && pnpm prepare && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "oxfmt .",
		"format:fw": "pnpm -C packages/farming-weight format",
		"lint": "pnpm lint:format && pnpm lint:ts && pnpm lint:fw && pnpm lint:svelte",
		"lint:format": "oxfmt --check .",
		"lint:ts": "oxlint --deny-warnings --tsconfig ./tsconfig.json src",
		"lint:fw": "pnpm -C packages/farming-weight lint",
		"lint:svelte": "eslint --cache --cache-location .eslintcache --max-warnings=0 \"src/**/*.svelte\"",
		"up": "docker-compose up -d database cache",
		"down": "docker-compose down",
		"test": "pnpm -C packages/farming-weight test",
		"test:web": "vitest run --config vite.config.ts --dir src",
		"license": "pnpm exec pnpm-licenses generate-disclaimer --output-file=./static/oss.txt",
		"generate-api": "pnpm orval",
		"postprocess-api": "node ./src/lib/api/util/morph-api.ts ./src/lib/api/client/EliteAPI.ts && pnpm oxfmt ./src/lib/api/client/EliteAPI.ts ./src/lib/api/schemas",
		"postprocess-zod": "node ./src/lib/api/util/morph-api.ts ./src/lib/api/client/EliteAPI.zod.ts && pnpm oxfmt ./src/lib/api/client/EliteAPI.zod.ts",
		"postprocess-stream-api": "node ./src/lib/api/util/morph-api.ts ./src/lib/stream-api/client/StreamAPI.ts STREAM_API_URL && pnpm oxfmt ./src/lib/stream-api/client/StreamAPI.ts ./src/lib/stream-api/schemas",
		"postprocess-stream-zod": "node ./src/lib/api/util/morph-api.ts ./src/lib/stream-api/client/StreamAPI.zod.ts && pnpm oxfmt ./src/lib/stream-api/client/StreamAPI.zod.ts",
		"postprocess-cms": "node ./src/lib/api/util/morph-api.ts ./src/lib/api/client/EliteCms.zod.ts && pnpm oxfmt ./src/lib/api/client/EliteCms.zod.ts"
	},
	"dependencies": {
		"@napi-rs/canvas": "^1.0.7",
		"@opentelemetry/api": "^1.9.1",
		"@tanstack/svelte-table": "^9.1.2",
		"@tebexio/tebex.js": "^1.11.0",
		"d3-shape": "^3.2.0",
		"farming-weight": "workspace:*",
		"isomorphic-dompurify": "^3.22.0",
		"sitemap": "^9.0.1",
		"three": "^0.185.1"
	},
	"devDependencies": {
		"@date-fns/utc": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@exodus/schemasafe": "^1.3.0",
		"@icons-pack/svelte-simple-icons": "^7.2.0",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.33.0",
		"@number-flow/svelte": "^0.4.2",
		"@orval/zod": "8.24.0",
		"@popperjs/core": "^2.11.8",
		"@quantco/pnpm-licenses": "^2.4.2",
		"@sinclair/typebox": "^0.34.52",
		"@standard-schema/spec": "^1.1.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tiptap/core": "^3.30.2",
		"@tiptap/extension-image": "^3.30.2",
		"@tiptap/extension-link": "^3.30.2",
		"@tiptap/extension-table": "^3.30.2",
		"@tiptap/extension-table-cell": "^3.30.2",
		"@tiptap/extension-table-header": "^3.30.2",
		"@tiptap/extension-table-row": "^3.30.2",
		"@tiptap/starter-kit": "^3.30.2",
		"@types/d3-array": "^3.2.2",
		"@types/d3-format": "^3.0.4",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-time-format": "^4.0.3",
		"@types/eslint": "^9.6.1",
		"@types/node": "^24.13.3",
		"@types/qs": "^6.15.1",
		"@types/three": "^0.185.4",
		"@typeschema/class-validator": "^0.3.0",
		"@vinejs/vine": "^4.4.0",
		"arktype": "^2.2.3",
		"bits-ui": "2.19.0",
		"class-validator": "^0.14.4",
		"classnames": "^2.5.1",
		"clsx": "^2.1.1",
		"concurrently": "^10.0.5",
		"d3-array": "^3.2.4",
		"d3-format": "^3.1.2",
		"d3-quadtree": "^3.0.1",
		"d3-scale": "^4.0.2",
		"d3-time-format": "^4.1.0",
		"date-fns": "^4.4.0",
		"dotenv": "^17.4.2",
		"embla-carousel-svelte": "8.6.0",
		"embla-carousel-wheel-gestures": "^8.1.0",
		"emoji-picker-element": "^1.29.1",
		"eslint": "10.8.1",
		"eslint-plugin-svelte": "^3.23.0",
		"formsnap": "2.0.1",
		"globals": "^17.11.0",
		"joi": "^18.2.5",
		"layerchart": "2.3.0",
		"marked": "^18.0.10",
		"mdsx": "^0.0.7",
		"mode-watcher": "^1.1.0",
		"orval": "8.24.0",
		"oxfmt": "^0.64.0",
		"oxlint": "^1.79.0",
		"paneforge": "1.0.2",
		"qs": "^6.15.3",
		"rehype-github-alerts": "^4.2.0",
		"rehype-pretty-code": "^0.14.5",
		"rehype-slug": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"runed": "^0.37.1",
		"superstruct": "^2.0.2",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"svelte-dnd-action": "0.9.78",
		"svelte-sonner": "^1.2.1",
		"svelte-time": "^2.3.1",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"ts-morph": "^28.0.0",
		"tslib": "^2.8.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"valibot": "^1.4.2",
		"vaul-svelte": "1.0.0-next.7",
		"velite": "^0.4.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"yup": "^1.7.1",
		"zod": "^4.4.3"
	}
}
